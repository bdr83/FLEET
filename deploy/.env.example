# انسخ إلى .env على الخادم ولا تضعه في git. ولّد الأسرار بـ: openssl rand -hex 32
TAG=latest

# خادم مخصص لهذه المنصة: caddy (HTTPS تلقائي على 80/443). خادم مشترك فيه وكيل عكسي: اتركه فارغًا
# ووجّه APP_DOMAIN إلى 127.0.0.1:WEB_PORT و API_DOMAIN إلى 127.0.0.1:API_PORT من الوكيل الموجود.
COMPOSE_PROFILES=caddy
API_PORT=3100
WEB_PORT=3101
# خادم مشترك فيه nginx في حاوية: اضمم الخادم واللوحة لشبكته، وحدد ملف إعداده ومجلد تحدي ACME
# COMPOSE_FILE=docker-compose.yml:docker-compose.shared.yml
# EDGE_NETWORK=
# NGINX_CONTAINER=
# NGINX_CONF=
# ACME_WEBROOT=
# ACME_WEBROOT_IN=

# النطاقان (سجلّا A يشيران إلى عنوان الخادم قبل التشغيل حتى تصدر شهادة HTTPS)
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# قاعدة البيانات
DB_ADMIN_PASSWORD=
APP_DB_PASSWORD=

# أسرار الخادم
AUTH_JWT_SECRET=
OTP_PEPPER=

# مزوّد الرسائل النصية لرمز الدخول (إلزامي في الإنتاج). مثال لبوابة HTTP عامة:
# الدخول بالبريد وكلمة المرور يعمل دائمًا. البريد مطلوب فقط لرسائل استعادة كلمة المرور:
# SMTP_URL=smtps://no-reply%40example.com:PASSWORD@smtp.hostinger.com:465   (الرموز الخاصة في كلمة المرور مرمَّزة URL)
# أو بدون ترميز: SMTP_HOST=smtp.hostinger.com SMTP_PORT=465 SMTP_USER=no-reply@example.com SMTP_PASS=...
SMTP_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# 1 = إظهار الدخول برقم الجوال في الموقع (يتطلب مزود SMS أدناه)
LOGIN_PHONE=0
SMS_PROVIDER=http
SMS_HTTP_URL=https://gateway.example/send
SMS_HTTP_HEADERS={"authorization":"Bearer CHANGE_ME"}
SMS_HTTP_BODY={"to":"{to}","message":"{text}","sender":"FLEET"}
SMS_HTTP_FORM=

# بلاطات الخريطة للوحة التحكم (تُثبَّت وقت بناء صورة الويب). خوادم OpenStreetMap العامة للتطوير فقط.
TILE_URL=
TILE_ATTRIBUTION=

LOCATION_RETENTION_DAYS=90
DB_POOL_MAX=20
# فقط إن احتجت معاينة تطبيق السائق على المتصفح
CORS_ORIGINS=
