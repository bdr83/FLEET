# apps/api
DATABASE_URL=postgresql://app_rw:devpass@localhost:5432/fleet
AUTH_JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
PORT=3000
OTP_PEPPER=change-me-16-chars-min
# local dev only, never in production: returns the OTP in the API response
OTP_DEV_ECHO=0

# مدة حفظ نقاط المواقع بالأيام (D6)، وصيانة الأقسام تعمل داخل الـ API كل 6 ساعات ما لم تُعطَّل
LOCATION_RETENTION_DAYS=90
MAINTENANCE_DISABLED=0
